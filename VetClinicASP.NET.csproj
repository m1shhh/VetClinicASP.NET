<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b8c4bb77-c2a7-4438-b8c0-1842b5091b01</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- PetCare.Tests е отделен тестов проект; изключи го от root компилацията. Без Content/None
         Remove Web SDK-а глоубва bin/obj файловете им като content → рекурсивно копиране в root bin. -->
    <Compile Remove="PetCare.Tests\**" />
    <EmbeddedResource Remove="PetCare.Tests\**" />
    <Content Remove="PetCare.Tests\**" />
    <None Remove="PetCare.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
