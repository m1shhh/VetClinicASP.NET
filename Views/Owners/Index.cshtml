@model IEnumerable<VetClinicASP.NET.Models.Owner>
@{
    ViewData["Title"] = "Собственици";
}

<div class="container mt-4">
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👥 Регистър на клиентите</h2>
        <a asp-action="Create" class="btn btn-success shadow">
            <i class="fa fa-user-plus"></i> Нов Клиент
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <form asp-action="Index" method="get" class="d-flex flex-wrap gap-3 align-items-center w-100">
                <div class="d-flex gap-2 flex-grow-1" style="max-width: 500px;">
                    <input type="text"
                           name="searchString"
                           class="form-control"
                           placeholder="Търсене на клиент по име..." />

                    <button type="submit" class="btn btn-primary text-nowrap">
                        🔍 Търсене
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary text-nowrap">
                        🗑️ Изчисти
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning" role="alert">
            Все още няма добавени клиенти в базата данни.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Име</th>
                            <th>Телефон</th>
                            <th>Адрес</th>
                            <th>Брой Животни</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var owner in Model)
                        {
                            <tr>
                                <td class="fw-bold">@owner.FullName</td>
                                <td>
                                    <a href="tel:@owner.PhoneNumber" class="text-decoration-none">
                                        📞 @owner.PhoneNumber
                                    </a>
                                </td>
                                <td>@owner.Address</td>
                                <td>
                                    @if (owner.Patients != null && owner.Patients.Count > 0)
                                    {
                                        <span class="badge bg-info text-dark">@owner.Patients.Count любимци</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted">Няма</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit"
                                       asp-route-id="@owner.OwnerId"
                                       class="btn btn-sm btn-warning"
                                       title="Редактирай">
                                        ✏️
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@owner.OwnerId" class="btn btn-sm btn-danger" title="Изтрий">
                                        🗑
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>