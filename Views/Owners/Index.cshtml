@model IEnumerable<VetClinicASP.NET.Models.Owner>

@{
    ViewData["Title"] = "Собственици";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👥 Клиенти (Собственици)</h2>
        <a asp-action="Create" class="btn btn-primary shadow">
            <i class="fa fa-user-plus"></i> Нов Клиент
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Име</th>
                        <th>Телефон</th>
                        <th>Адрес</th>
                        <th>Брой Животни</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var owner in Model)
                    {
                        <tr>
                            <td class="fw-bold">@owner.FullName</td>
                            <td>
                                <a href="tel:@owner.PhoneNumber" class="text-decoration-none">
                                    📞 @owner.PhoneNumber
                                </a>
                            </td>
                            <td>@owner.Address</td>
                            <td>
                                @if (owner.Patients != null && owner.Patients.Count > 0)
                                {
                                    <span class="badge bg-info text-dark">@owner.Patients.Count любимци</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted">Няма</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Delete" asp-route-id="@owner.OwnerId"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('ВНИМАНИЕ: Ако изтриете собственика, ще бъдат изтрити и всички негови животни! Сигурни ли сте?');">
                                    🗑 Изтрий
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>