@model IEnumerable<VetClinicASP.NET.Models.Appointment>

@{
    ViewData["Title"] = "График прегледи";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>📅 График @ViewBag.FilterName</h2>

            @if (ViewBag.CurrentVetId != null)
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-1">
                    ↩ Покажи всички лекари
                </a>
            }
        </div>

        <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary shadow">
            + Нов час
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Няма записани прегледи по тези критерии.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Дата & Час</th>
                            <th>Пациент</th>
                            <th>Лекар</th>
                            <th>Причина</th>
                            <th>Статус</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            bool isPast = item.AppointmentDate < DateOnly.FromDateTime(DateTime.Now);

                            <tr class="@(isPast ? "text-muted bg-light" : "")">
                                <td>
                                    <div class="fw-bold">@item.AppointmentDate.ToString("dd.MM.yyyy")</div>
                                    <small>@item.AppointmentTime.ToString("HH:mm") ч.</small>
                                </td>
                                <td>
                                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@item.PatientId" class="text-decoration-none fw-bold">
                                        🐾 @item.Patient.Name
                                    </a>
                                </td>
                                <td>
                                    @if (item.Vet != null)
                                    {
                                        <a asp-action="Index" asp-route-vetId="@item.VetId" class="text-decoration-none text-dark" title="Кликни за филтър">
                                            👨‍⚕️ @item.Vet.FullName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-danger">Не е назначен</span>
                                    }
                                </td>
                                <td>@item.Reason</td>
                                <td>
                                    @if (isPast)
                                    {
                                        <span class="badge bg-secondary">Минал</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-success">Предстоящ</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="Delete" asp-route-id="@item.AppointmentId"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('Сигурни ли сте, че искате да изтриете този час?');">
                                        ❌ Изтрий
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>