@using VetClinic.Models.ViewModels
@model List<PatientViewModel>

@{
    ViewData["Title"] = "Списък с пациенти";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🐶 Регистър на пациентите</h2>
        <a asp-action="Create" class="btn btn-success shadow">
            <i class="fa fa-plus"></i> Нов пациент
        </a>
    </div>
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary shadow h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Общо Пациенти</h5>
                        <h2 class="display-4 fw-bold">@ViewBag.TotalPatients</h2>
                    </div>
                    <div>
                        <i class="fa fa-paw fa-4x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-success shadow h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Лекари</h5>
                        <h2 class="display-4 fw-bold">@ViewBag.TotalDoctors</h2>
                    </div>
                    <div>
                        <i class="fa fa-user-md fa-4x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white @(ViewBag.AppointmentsToday > 0 ? "bg-warning" : "bg-secondary") shadow h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Прегледи Днес</h5>
                        <h2 class="display-4 fw-bold">@ViewBag.AppointmentsToday</h2>
                    </div>
                    <div>
                        <i class="fa fa-calendar-check fa-4x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-12">
            <form asp-action="Index" method="get" class="d-flex flex-wrap gap-3 align-items-center w-100">

                <div class="d-flex gap-2 flex-grow-1" style="max-width: 500px;">
                    <input type="text"
                           name="searchString"
                           value="@ViewBag.CurrentFilter"
                           class="form-control"
                           placeholder="Въведете текст за търсене..." />

                    <button type="submit" class="btn btn-primary text-nowrap">
                        🔍 Търсене
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary text-nowrap">
                        🗑️ Изчисти
                    </a>
                </div>

                <div class="d-flex gap-2 ms-auto">
                    <select name="filterType" class="form-select w-auto bg-light border-secondary">
                        <option value="name" selected="@(ViewBag.CurrentFilterType == "name")">По име</option>
                        <option value="owner" selected="@(ViewBag.CurrentFilterType == "owner")">По собственик</option>
                        <option value="breed" selected="@(ViewBag.CurrentFilterType == "breed")">По порода</option>
                        <option value="age" selected="@(ViewBag.CurrentFilterType == "age")">По възраст</option>
                    </select>

                    <select name="sortOrder" class="form-select w-auto bg-light border-secondary">
                        <option value="asc" selected="@(ViewBag.CurrentSort == "asc")">Възходящ (А-Я / 0-9)</option>
                        <option value="desc" selected="@(ViewBag.CurrentSort == "desc")">Низходящ (Я-А / 9-0)</option>
                    </select>
                </div>

            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning" role="alert">
            Все още няма добавени пациенти в базата данни.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Име</th>
                            <th>Вид</th>
                            <th>Порода</th>
                            <th>Възраст</th>
                            <th>Собственик</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <td class="fw-bold">@patient.Name</td>
                                <td>
                                    @if (patient.Species == "Куче")
                                    {
                                        <span>🐕</span>
                                    }
                                    else if (patient.Species == "Котка")
                                    {

                                        <span>🐈</span>
                                    }
                                    else
                                    {

                                        <span>🐾</span>
                                    }
                                    @patient.Species
                                </td>
                                <td>@patient.Breed</td>
                                <td>@patient.Age г.</td>
                                <td>@patient.OwnerName</td>
                                <td class="text-end">
                                    <a asp-controller="Patients"
                                       asp-action="Details"
                                       asp-route-id="@patient.Id"
                                       class="btn btn-sm btn-info text-white"
                                       title="Виж досие">
                                        📂
                                    </a>

                                    <a asp-controller="Patients"
                                       asp-action="Edit"
                                       asp-route-id="@patient.Id"
                                       class="btn btn-sm btn-warning"
                                       title="Редактирай">
                                        ✏️
                                    </a>

                                    <a asp-controller="Patients"
                                       asp-action="Delete"
                                       asp-route-id="@patient.Id"
                                       class="btn btn-sm btn-danger"
                                       title="Изтрий">
                                        🗑
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>