@using VetClinic.Models.ViewModels
@model List<PatientViewModel>

@{
    ViewData["Title"] = "Списък с пациенти";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🐶 Регистър на пациентите</h2>
        <a href="#" class="btn btn-success">
            <i class="fa fa-plus"></i> Нов пациент
        </a>
    </div>
    <div class="alert alert-info">
        Търсим думата: "@ViewBag.CurrentFilter"
    </div>
    <div class="row mb-3">
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="text"
                       name="searchString"  <-- ТОВА Е КЛЮЧЪТ! Трябва да е точно "searchString"
                                                value="@ViewBag.CurrentFilter"
                                                class="form-control"
                       placeholder="Търси по име на пациент или собственик..." />

                <button type="submit" class="btn btn-primary">
                    🔍 Търсене
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning" role="alert">
            Все още няма добавени пациенти в базата данни.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Име</th>
                            <th>Вид</th>
                            <th>Порода</th>
                            <th>Възраст</th>
                            <th>Собственик</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <td class="fw-bold">@patient.Name</td>
                                <td>
                                    @if (patient.Species == "Куче")
                                    {
                                        <span>🐕</span>
                                    }
                                    else if (patient.Species == "Котка")
                                    {

                                        <span>🐈</span>
                                    }
                                    else
                                    {

                                        <span>🐾</span>
                                    }
                                    @patient.Species
                                </td>
                                <td>@patient.Breed</td>
                                <td>@patient.Age г.</td>
                                <td>@patient.OwnerName</td>
                                <td class="text-end">
                                    <a asp-controller="Patients"
                                       asp-action="Details"
                                       asp-route-id="@patient.Id"
                                       class="btn btn-sm btn-primary">
                                        Досие
                                    </a>

                                    <a asp-controller="Patients"
                                       asp-action="Edit"
                                       asp-route-id="@patient.Id"
                                       class="btn btn-sm btn-warning">
                                        Редактирай
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>