@{
    ViewData["Title"] = "Входът е отказан";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow text-center">
                <div class="card-header bg-warning">
                    <h3 class="mb-0">🔒 Входът е отказан</h3>
                </div>
                <div class="card-body">
                    <p class="mb-2">Акаунтът на вашата клиника е временно недостъпен.</p>
                    <p class="mb-3 text-muted">
                        Твърде много неуспешни опити за вход, или акаунтът/клиниката е деактивирана.
                        Свържете се с администратора на клиниката или с поддръжката.
                    </p>
                    <a asp-action="Login" class="btn btn-secondary">Обратно към входа</a>
                </div>
            </div>
        </div>
    </div>
</div>
