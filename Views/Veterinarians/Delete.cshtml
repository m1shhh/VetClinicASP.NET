@model VetClinicASP.NET.Models.Veterinarian

@{
    ViewData["Title"] = "Изтриване на лекар";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">🚨 Внимание! Изтриване на лекар</h4>
                </div>
                <div class="card-body text-center">
                    <h5 class="card-title">Сигурни ли сте, че искате да премахнете този лекар от системата?</h5>
                    <p class="card-text text-muted">Това действие е необратимо.</p>

                    <div class="alert alert-warning">
                        <strong>👨‍⚕️ @Model.FullName</strong> <br>
                        🕒 Работно време: @(Model.WorkingHours ?? "Няма въведено")
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="VetId" />

                        <button type="submit" class="btn btn-danger btn-lg">
                            🗑 Да, премахни лекаря
                        </button>

                        <a asp-action="Index" class="btn btn-secondary btn-lg">
                            Отказ
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>