@model IEnumerable<VetClinicASP.NET.Models.Veterinarian>

@{
    ViewData["Title"] = "Нашите лекари";
}

<div class="container mt-4">
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👨‍⚕️ Екип от специалисти</h2>
        <a asp-action="Create" class="btn btn-success shadow">
            <i class="fa fa-user-plus"></i> Нов лекар
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <form asp-action="Index" method="get" class="d-flex flex-wrap gap-3 align-items-center w-100">
                <div class="d-flex gap-2 flex-grow-1" style="max-width: 500px;">
                    <input type="text"
                           name="searchString"
                           class="form-control"
                           placeholder="Търсене на лекар по име..." />

                    <button type="submit" class="btn btn-primary text-nowrap">
                        🔍 Търсене
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary text-nowrap">
                        🗑️ Изчисти
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning" role="alert">
            Все още няма добавени лекари в системата.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Специалист</th>
                            <th>Работно време</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vet in Model)
                        {
                            <tr>
                                <td class="fw-bold">
                                    <i class="fa fa-user-md text-primary me-2"></i> @vet.FullName
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(vet.WorkingHours))
                                    {
                                        <span>🕒 @vet.WorkingHours</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Няма въведено</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Appointments"
                                       asp-action="Index"
                                       asp-route-vetId="@vet.VetId"
                                       class="btn btn-sm btn-info text-white"
                                       title="Виж график">
                                        📅
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@vet.VetId"
                                       class="btn btn-sm btn-warning"
                                       title="Редактирай">
                                        ✏️
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@vet.VetId" class="btn btn-sm btn-danger" title="Изтрий лекаря">
                                        🗑
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>