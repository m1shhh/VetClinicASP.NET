@model IEnumerable<VetClinicASP.NET.Models.Veterinarian>

@{
    ViewData["Title"] = "Нашите лекари";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👨‍⚕️ Екип от специалисти</h2>
        <a asp-action="Create" class="btn btn-success">
            + Добави лекар
        </a>
    </div>

    <div class="row">
        @foreach (var vet in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="fa fa-user-md fa-4x text-primary"></i>
                        </div>
                        <h5 class="card-title fw-bold">@vet.FullName</h5>

                        @* <p class="text-muted">@vet.Specialization</p> *@

                        <hr />
                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold">@vet.FullName</h5>

                            <hr />
                            <div class="d-grid gap-2">
                                <a asp-controller="Appointments" asp-action="Index" asp-route-vetId="@vet.VetId"
                                   class="btn btn-outline-primary btn-sm">
                                    📅 Виж график
                                </a>

                                <a asp-action="Delete" asp-route-id="@vet.VetId"
                                   class="btn btn-outline-danger btn-sm"
                                   onclick="return confirm('ВНИМАНИЕ: Сигурни ли сте, че искате да премахнете този лекар от системата?');">
                                    🗑 Изтрий лекаря
                                </a>
                            </div>
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-controller="Appointments" asp-action="Index" asp-route-vetId="@vet.VetId"
                               class="btn btn-outline-primary btn-sm">
                                📅 Виж график
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>