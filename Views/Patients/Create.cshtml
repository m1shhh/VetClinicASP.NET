@model VetClinic.Models.ViewModels.PatientInputModel

@{
    ViewData["Title"] = "Добавяне на пациент";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">🐾 Нова регистрация</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="Име на любимеца" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Species" class="form-label"></label>
                                <select asp-for="Species" class="form-select">
                                    <option value="">-- Избери вид --</option>
                                    <option value="Куче">Куче</option>
                                    <option value="Котка">Котка</option>
                                    <option value="Птица">Птица</option>
                                    <option value="Заек">Заек</option>
                                </select>
                                <span asp-validation-for="Species" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Breed" class="form-label"></label>
                                <input asp-for="Breed" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Age" class="form-label"></label>
                            <input asp-for="Age" type="number" class="form-control" />
                            <span asp-validation-for="Age" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OwnerId" class="form-label"></label>
                            <select asp-for="OwnerId" class="form-select" asp-items="ViewBag.Owners">
                                <option value="">-- Избери собственик --</option>
                            </select>
                            <span asp-validation-for="OwnerId" class="text-danger"></span>
                            <small class="text-muted">Ако собственикът го няма, първо го регистрирайте в меню "Собственици".</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Запиши пациента</button>
                            <a asp-action="Index" class="btn btn-secondary">Отказ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>