@model VetClinic.Models.ViewModels.PatientDetailsViewModel

@{
    ViewData["Title"] = "Досие на " + Model.Name;
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-5">🩺 Досие: <span class="text-primary fw-bold">@Model.Name</span></h1>
            <h4 class="text-muted">@Model.Species / @Model.Breed / @Model.Age г.</h4>
        </div>
        <div class="col-md-4 text-end">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">⬅ Назад към списъка</a>

            <a asp-controller="Patients"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                ✏️ Редакция
            </a>
        </div>
    </div>

    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">📋 Основна информация</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">💉 История на прегледи</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#vaccines" type="button" role="tab">🛡 Ваксинации</button>
        </li>
    </ul>

    <div class="tab-content p-4 border border-top-0 bg-white shadow-sm" id="myTabContent">

        <div class="tab-pane fade show active" id="info" role="tabpanel">
            <div class="row">
                <div class="col-md-6">
                    <h5>Данни за собственика</h5>
                    <hr />
                    <p><strong>Име:</strong> @Model.OwnerName</p>
                    <p><strong>Телефон:</strong> @(Model.OwnerPhone ?? "Няма данни")</p>
                    <p><strong>Адрес:</strong> @(Model.OwnerAddress ?? "Няма данни")</p>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="history" role="tabpanel">
            <div class="d-flex justify-content-between mb-3 mt-3">
                <h5>Хронология на прегледите (Медицински картон)</h5>
                <a asp-controller="MedicalRecords" asp-action="Create" asp-route-patientId="@Model.Id" class="btn btn-sm btn-primary">
                    + Нов преглед
                </a>
            </div>

            @if (Model.Visits != null && Model.Visits.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Дата</th>
                                <th>Диагноза</th>
                                <th>Лечение</th>
                                <th>Бележки</th>
                                <th>Лекар</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var visit in Model.Visits)
                            {
                                <tr>
                                    <td style="white-space: nowrap;">@visit.Date.ToString("dd.MM.yyyy HH:mm")</td>

                                    <td>@(visit.Diagnosis ?? "Няма данни")</td>

                                    <td>@(visit.Treatment ?? "-")</td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(visit.Notes))
                                        {
                                            <span class="text-muted small">@visit.Notes</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>

                                    <td style="white-space: nowrap;">👨‍⚕️ @visit.DoctorName</td>

                                    <td style="white-space: nowrap;">
                                        <a asp-controller="MedicalRecords" asp-action="Edit" asp-route-id="@visit.RecordId" class="btn btn-sm btn-outline-warning" title="Редактирай">
                                            ✏️
                                        </a>
                                        <a asp-controller="MedicalRecords" asp-action="Delete" asp-route-id="@visit.RecordId" class="btn btn-sm btn-outline-danger" title="Изтрий" onclick="return confirm('Сигурни ли сте, че искате да изтриете този картон?');">
                                            🗑
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-light border">
                    <i class="fa fa-info-circle"></i> Няма записани прегледи (медицински картони) за този пациент до момента.
                </div>
            }
        </div>

        <div class="tab-pane fade" id="vaccines" role="tabpanel">
            <div class="d-flex justify-content-between mb-3 mt-3">
                <h5>Ваксинационен паспорт</h5>
                <a asp-controller="Vaccinations"
                   asp-action="Create"
                   asp-route-patientId="@Model.Id"
                   class="btn btn-sm btn-success">
                    + Нова ваксина
                </a>
            </div>

            @if (Model.Vaccinations != null && Model.Vaccinations.Any())
            {
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Ваксина / Препарат</th>
                            <th>Дата на поставяне</th>
                            <th>Следваща дата</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Vaccinations)
                        {
                            // Оправено сравнението за DateOnly модели!
                            bool isOverdue = v.NextDueDate.HasValue && v.NextDueDate.Value < DateTime.Now;

                            <tr class="@(isOverdue ? "table-danger" : "")">
                                <td><strong>@v.VaccineName</strong></td>
                                <td>@v.DateAdministered.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @(v.NextDueDate.HasValue? v.NextDueDate.Value.ToString("dd.MM.yyyy") : "-")
                                </td>
                                <td>
                                    @if (isOverdue)
                                    {
                                        <span class="badge bg-danger">Изтекла!</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Активна</span>
                                    }
                                </td>
                                <td style="white-space: nowrap;">
                                    <a asp-controller="Vaccinations"
                                       asp-action="Edit"
                                       asp-route-id="@v.Id"
                                       class="btn btn-sm btn-outline-warning" title="Редактирай">
                                        ✏️
                                    </a>
                                    <a asp-controller="Vaccinations"
                                       asp-action="Delete"
                                       asp-route-id="@v.Id"
                                       class="btn btn-sm btn-outline-danger" title="Изтрий"
                                       onclick="return confirm('Сигурни ли сте, че искате да изтриете този запис за ваксинация?');">
                                        🗑
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-light border text-center p-4">
                    <p class="text-muted mb-0">Няма данни за ваксинации за този пациент.</p>
                    <small>Използвайте бутона горе вдясно, за да добавите първата ваксина.</small>
                </div>
            }
        </div>
    </div>
</div>